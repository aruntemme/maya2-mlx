# Copy to .env (gitignored) and fill in. Every value can also be set as an environment variable.

# Speech recognition for the call agent (Deepgram Nova-3, Tamil/English). Leave empty to use local Whisper.
DEEPGRAM_API_KEY=

# The call agent's LLM: any OpenAI-compatible chat API. Leave all empty for a local mlx_lm.server on port 18090.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional, for reasoning models: none | low | medium | high
LLM_REASONING_EFFORT=

# Optional: another .env file to read any of the settings above from.
# EXTRA_ENV_FILE=~/path/to/other/.env

# LiveKit: the defaults below are livekit-server --dev's well-known test keys. Use real keys for anything shared.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
