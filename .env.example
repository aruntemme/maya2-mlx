# Copy to .env (gitignored) and fill in. Every value can also be set as an environment variable.

# Speech recognition for the call agent (Deepgram Nova-3, Tamil/English). Leave empty to use local Whisper.
DEEPGRAM_API_KEY=

# The call agent's LLM (AWS Bedrock). Leave empty to use the standard AWS credential chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, SSO, instance role).
BEDROCK_AWS_KEY=
BEDROCK_AWS_SECRET=

# Optional: another .env file to read the keys above from.
# EXTRA_ENV_FILE=~/path/to/other/.env

# LiveKit: the defaults below are livekit-server --dev's well-known test keys. Use real keys for anything shared.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
